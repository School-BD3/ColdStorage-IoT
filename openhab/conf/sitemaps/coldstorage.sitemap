        Text item=Chamber2_Alarm label="Сигнализация [%s]"
        Text item=Chamber2_OutageSeconds label="Время отключения [%.0f с]"
        Text item=Chamber2_Status label="Датчик [%s]"
        Text item=Chamber2_Event label="Последнее MQTT-событие [%s]"
        Chart item=Chamber2_Temperature period=h refresh=10000
    }

    Frame label="Камера 3" {
        Text item=Chamber3_Temperature label="Температура [%.2f °C]"
        Text item=Chamber3_Door label="Дверь [%s]"
        Text item=Chamber3_Mains label="Электропитание [%s]"
